{
  "scripts": {
    "dev": "ts-node-dev --respawn --require tsconfig-paths/register src/index.ts",
    "dev:views": "npx @tailwindcss/cli -i ./public/assets/css/input.css -o ./public/assets/css/output.css --watch",
    "start": "node out/index.js",
    "test:dev": "jest --config jest.config.ts",
    "test:prod": "jest --config jest.config.prod.ts",
    "build": "rimraf out && tsc"
  },
  "dependencies": {
    "@fastify/static": "^8.1.1",
    "@fastify/view": "^11.1.0",
    "@tailwindcss/cli": "^4.1.6",
    "@types/jest": "^29.5.14",
    "body-parser": "^2.2.0",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "ejs": "^3.1.10",
    "fastify": "^5.3.3",
    "flyonui": "^2.1.0",
    "handlebars": "^4.7.8",
    "jest": "^29.7.0",
    "mysql2": "^3.14.1",
    "tailwindcss": "^4.1.6",
    "ts-jest": "^29.3.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.8.3"
  },
  "devDependencies": {
    "@iconify/json": "^2.2.337",
    "@iconify/tailwind4": "^1.0.6",
    "@types/ejs": "^3.1.5",
    "rimraf": "^6.0.1",
    "tsconfig-paths": "^4.2.0"
  }
